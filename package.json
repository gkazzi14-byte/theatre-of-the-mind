{
  "name": "theatre-of-the-mind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "audio:assets": "python3 scripts/soundscapes.py",
    "prepare:audio": "node --import tsx audio-tool/prepare.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "@types/jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
